{
  "name": "pdfforge",
  "version": "0.2.0",
  "description": "Privacy-first PDF tools from ceskacan",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --test tests/*.test.mjs",
    "check": "npm run test && node --check src/app.js && node --check src/engine.js && node --check src/pdf-core.js && node --check src/i18n.js && npm run build"
  },
  "dependencies": {
    "pdf-lib": "1.17.1",
    "pdfjs-dist": "4.10.38",
    "jszip": "3.10.1"
  },
  "devDependencies": {
    "vite": "6.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
